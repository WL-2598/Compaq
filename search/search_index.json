4e8b\u4f1a\uff08\u51b3\u8bae\u516c\u5f00\uff09</li> <li>KPI\uff08\u53c2\u8003\uff0c\u4ee5\u5b9e\u9645\u6570\u636e\u6821\u6b63\uff09\uff1a</li> </ul> \u6307\u6807 \u7b2c 3 \u4e2a\u6708 \u7b2c 6 \u4e2a\u6708 \u7b2c 12 \u4e2a\u6708 \u6708\u6536\u5165 \u00a53,000 \u00a510,000 \u00a530,000 \u4ed8\u8d39\u6258\u7ba1\u5b9e\u4f8b 20 80 160 \u8d5e\u52a9\u4eba\u6570 50 100 150 \u4f01\u4e1a\u4ed8\u8d39\u5ba2\u6237 0 1 3 \u6d3b\u8dc3\u5916\u90e8\u8d21\u732e\u8005 10 25 50"},{"location":"roadmap/#_2","title":"\u4f18\u5148\u7ea7\u6807\u8bb0","text":"<ul> <li>P0\uff08\u5fc5\u987b\uff09\uff1a\u5408\u89c4\u4e0e\u5730\u57fa\uff0c\u963b\u585e\u4e00\u5207\u5546\u4e1a\u52a8\u4f5c</li> <li>P1\uff08\u5e94\u8be5\uff09\uff1a\u793e\u533a\u589e\u957f</li> <li>P2\uff08\u53ef\u4ee5\uff09\uff1a\u53d8\u73b0\u5b9e\u9a8c</li> <li>\u6bcf\u9879\u4efb\u52a1\u5728 Issue \u4e2d\u6807\u6ce8\u4f18\u5148\u7ea7\u6807\u7b7e\uff0c\u5b63\u5ea6\u672b\u56de\u987e\u5e76\u6eda\u52a8\u66f4\u65b0\u672c\u9875\u3002</li> </ul>"},{"location":"third-party-licenses/","title":"\u7b2c\u4e09\u65b9\u8bb8\u53ef\u8bc1\u5ba1\u8ba1","text":"<ul> <li>\u6700\u8fd1\u626b\u63cf\uff1a2026-11-24\uff08\u968f v0.1.0\uff09</li> <li>\u626b\u63cf\u8303\u56f4\uff1a\u4ed3\u5e93\u6839\u76ee\u5f55</li> <li>\u7ed3\u679c\uff1a\u8fd0\u884c\u65f6\u96f6\u7b2c\u4e09\u65b9\u4f9d\u8d56\uff08<code>pyproject.toml</code> \u4e2d <code>dependencies = []</code>\uff0c\u4ee3\u7801\u4ec5\u7528 Python \u6807\u51c6\u5e93\uff09\uff0c\u65e0\u8bb8\u53ef\u8bc1\u98ce\u9669\u3002</li> <li>\u5f00\u53d1/\u6d4b\u8bd5\uff1a\u6807\u51c6\u5e93 <code>unittest</code>\uff0c\u65e0\u989d\u5916\u5305</li> <li>\u6587\u6863\u7ad9\uff08\u4ec5\u6784\u5efa\u671f\uff09\uff1a<code>mkdocs</code> + <code>mkdocs-material</code>\uff08MIT / CC BY-NC-SA\uff09\uff0c\u89c1 <code>requirements-docs.txt</code></li> <li>CI \u5de5\u5177\uff1a<code>build</code>\uff08MIT\uff09\uff0c\u4e0d\u968f\u4ea7\u54c1\u5206\u53d1</li> </ul>"},{"location":"third-party-licenses/#_2","title":"\u91cd\u65b0\u626b\u63cf","text":"<pre><code># Python\npip install pip-licenses &amp;&amp; pip-licenses --format=markdown &gt; docs/third-party-licenses.md\n\n# Node\nnpx license-checker --summary\n\n# \u901a\u7528\uff08\u63a8\u8350\uff09\npip install scancode-toolkit\nscancode -l --json-pp scan.json .\n</code></pre>"},{"location":"third-party-licenses/#_3","title":"\u5f15\u5165\u4f9d\u8d56\u65f6\u7684\u89c4\u5219","text":"<ol> <li>\u65b0\u589e\u4f9d\u8d56\u5fc5\u987b\u5728\u672c\u6587\u4ef6\u767b\u8bb0\uff1a\u540d\u79f0\u3001\u7248\u672c\u3001\u8bb8\u53ef\u8bc1\uff1b</li> <li>GPL / AGPL \u7b49\u5f3a\u4f20\u67d3\u6027\u8bb8\u53ef\u8bc1\u9ed8\u8ba4\u7981\u6b62\u5f15\u5165\uff1b\u786e\u9700\u5f15\u5165\u65f6\u8bb0\u5f55\u5230 <code>docs/license-risk.md</code>\uff0c\u8bf4\u660e\u66ff\u6362\u6216\u9694\u79bb\uff08\u72ec\u7acb\u8fdb\u7a0b / \u5b50\u6a21\u5757\uff09\u65b9\u6848\uff0c\u5e76\u7ecf\u7ef4\u62a4\u8005\u6295\u7968\uff1b</li> <li>MIT / Apache-2.0 / BSD / ISC \u7b49\u5bbd\u677e\u8bb8\u53ef\u8bc1\u53ef\u76f4\u63a5\u5f15\u5165\uff0c\u6ce8\u610f\u4fdd\u7559\u7248\u6743\u58f0\u660e\u3002</li> </ol>"},{"location":"third-party-licenses/#_4","title":"\u98ce\u9669\u9879","text":"<p>\u65e0\uff08\u5f53\u524d\u96f6\u4f9d\u8d56\uff09\u3002\u51fa\u73b0 GPL/AGPL \u65f6\u65b0\u5efa <code>docs/license-risk.md</code> \u8bb0\u5f55\u3002</p>"},{"location":"troubleshooting/","title":"\u6545\u969c\u6392\u67e5","text":"<p>\u5f85\u9996\u4e2a\u7248\u672c\u53d1\u5e03</p> <p>\u672c\u9875\u5c06\u6536\u5f55\u6309\u75c7\u72b6\u5206\u7c7b\u7684\u6392\u67e5\u8def\u5f84\uff1a\u542f\u52a8\u5931\u8d25\u3001\u6027\u80fd\u8fc7\u4f4e\u3001\u63d2\u4ef6\u51b2\u7a81\u3001\u7f51\u7edc\u95ee\u9898\u7b49\u3002</p>"},{"location":"troubleshooting/#_2","title":"\u89c4\u5212\u4e2d\u7684\u6392\u67e5\u8def\u5f84","text":"\u75c7\u72b6 \u5148\u68c0\u67e5 \u6587\u6863 \u542f\u52a8\u5931\u8d25 \u65e5\u5fd7\u4f4d\u7f6e\u3001\u4f9d\u8d56\u7248\u672c \u5f85\u8865\u5145 \u65e7\u673a\u5668\u4e0a\u592a\u6162 \u5185\u5b58/\u78c1\u76d8\u9650\u5236\u3001\u53ef\u5173\u95ed\u7684\u7279\u6027 \u5f85\u8865\u5145 \u63d2\u4ef6\u4e0d\u751f\u6548 <code>plugin.json</code> \u517c\u5bb9\u8303\u56f4\u3001\u5165\u53e3\u6587\u4ef6 \u89c1 <code>registry/</code> \u89c4\u8303 \u5347\u7ea7\u540e\u884c\u4e3a\u53d8\u5316 CHANGELOG \u7684 Changed / Fixed \u5f85\u8865\u5145 <p>\u4ecd\u672a\u89e3\u51b3 \u2192 \u5f00 Issue\uff08\u7528 Bug \u6a21\u677f\uff0c\u9644\u7248\u672c\u53f7\u4e0e\u73af\u5883\u4fe1\u606f\uff09\u3002</p>"},{"location":"finance/TEMPLATE/","title":"\u8d22\u52a1\u62a5\u544a\uff1a____ \u5e74\u7b2c __ \u5b63\u5ea6","text":"<p>\u6bcf\u5b63\u5ea6\u53d1\u5e03\u4e00\u6b21\uff0c\u590d\u5236\u672c\u6a21\u677f\u5230 <code>docs/finance/YYYY-Qn.md</code>\u3002\u53d1\u5e03\u524d\u7531\u9879\u76ee\u8d1f\u8d23\u4eba\u786e\u8ba4\u6570\u5b57\uff0c\u6cbb\u7406\u6d41\u7a0b\u89c1 GOVERNANCE.md\u3002</p>"},{"location":"finance/TEMPLATE/#_1","title":"\u6536\u5165","text":"\u6765\u6e90 \u91d1\u989d \u5360\u6bd4 \u8d5e\u52a9 \u6258\u7ba1\u670d\u52a1 \u8bfe\u7a0b \u8d4f\u91d1\u5e73\u53f0\u62bd\u6210 \u4f01\u4e1a\u7248\u6388\u6743 <p>\u7ea2\u7ebf\u81ea\u68c0\uff1a\u5355\u4e00\u6765\u6e90 \u2264 40%\uff1f\u5355\u4e00\u5ba2\u6237 \u2264 30%\uff1f\uff08\u662f / \u5426\uff0c\u82e5\u5426\u5219\u5728\u4e0b\u65b9\u8bf4\u660e\u8c03\u6574\u8ba1\u5212\uff09</p>"},{"location":"finance/TEMPLATE/#_2","title":"\u652f\u51fa","text":"\u9879\u76ee \u91d1\u989d \u8bf4\u660e \u670d\u52a1\u5668 AI \u63a8\u7406 API \u7ef4\u62a4\u8005\u62a5\u916c \u8d4f\u91d1 \u5de5\u5177\u4e0e\u6cd5\u52a1"},{"location":"finance/TEMPLATE/#_3","title":"\u8d44\u91d1\u53bb\u5411\u4e0e\u8ba1\u5212","text":""},{"location":"finance/TEMPLATE/#_4","title":"\u4e0b\u5b63\u5ea6\u76ee\u6807","text":""},{"location":"finance/TEMPLATE/#_5","title":"\u8d64\u5b57 / \u7ed3\u4f59\u8bf4\u660e","text":""},{"location":"legal/hosted-service-checklist/","title":"\u6258\u7ba1\u670d\u52a1\u4e0a\u7ebf\u524d\u6cd5\u5f8b\u6e05\u5355\uff08P2\uff09","text":"<p>\u26a0\ufe0f \u672c\u6e05\u5355\u4ec5\u4e3a\u5907\u5fd8\uff0c\u6240\u6709\u6761\u76ee\u5728\u5b9e\u65bd\u524d\u5fc5\u987b\u54a8\u8be2\u5f8b\u5e08\uff0c\u4e0d\u8981\u81ea\u884c\u5224\u65ad\u3002 \u5546\u4e1a\u51b3\u7b56\uff08\u7b7e\u5408\u540c\u3001\u5f00\u6536\u6b3e\u8d26\u6237\u3001\u5b9a\u4ef7\u3001\u9009\u62e9\u516c\u53f8\u4e3b\u4f53\uff09\u7531\u9879\u76ee\u8d1f\u8d23\u4eba\u672c\u4eba\u786e\u8ba4\u3002</p>"},{"location":"legal/hosted-service-checklist/#_1","title":"\u4e3b\u4f53\u4e0e\u8d44\u8d28","text":"<ul> <li>[ ] \u8425\u4e1a\u6267\u7167\uff1a\u4e2a\u4f53\u5de5\u5546\u6237\u6216\u516c\u53f8\u2014\u2014\u4e3b\u4f53\u51b3\u5b9a\u7a0e\u52a1\u4e0e\u8d23\u4efb\uff0c\u9700\u5f8b\u5e08/\u4f1a\u8ba1\u5efa\u8bae</li> <li>[ ] ICP \u5907\u6848\uff1a\u5bf9\u5883\u5185\u516c\u4f17\u63d0\u4f9b\u6258\u7ba1\u670d\u52a1\u901a\u5e38\u6d89\u53ca\u5907\u6848</li> <li>[ ] \u589e\u503c\u7535\u4fe1\u4e1a\u52a1\u7ecf\u8425\u8bb8\u53ef\uff1a\u662f\u5426\u9700\u8981\uff08EDI / ICP \u7c7b\uff09\u7531\u5f8b\u5e08\u5224\u65ad</li> <li>[ ] \u6536\u6b3e\u6e20\u9053\u5408\u89c4\uff1a\u652f\u4ed8\u5b9d/\u5fae\u4fe1\u652f\u4ed8\u5546\u6237\u53f7\uff0c\u6216\u6d77\u5916 Stripe</li> </ul>"},{"location":"legal/hosted-service-checklist/#_2","title":"\u7528\u6237\u6587\u6863\uff08\u4e0a\u7ebf\u524d\u5fc5\u987b\u6210\u7a3f\uff09","text":"<ul> <li>[ ] \u300a\u670d\u52a1\u6761\u6b3e\u300b</li> <li>[ ] \u300a\u9690\u79c1\u653f\u7b56\u300b</li> <li>[ ] \u300a\u6570\u636e\u5904\u7406\u8bf4\u660e\u300b</li> <li>[ ] \u5907\u4efd\u6570\u636e\u7684\u4fdd\u7559\u671f\u9650\u4e0e\u5220\u9664\u6d41\u7a0b\u5199\u5165\u4e0a\u8ff0\u6587\u6863</li> <li>[ ] \u5b89\u5168\u4e8b\u4ef6\u901a\u77e5\u6d41\u7a0b\uff08\u4e0e SECURITY.md \u8854\u63a5\uff09</li> </ul>"},{"location":"legal/hosted-service-checklist/#60","title":"\u4f01\u4e1a\u8bd5\u70b9\uff0860 \u5929\u514d\u8d39\u8bd5\u7528\uff09","text":"<ul> <li>[ ] \u8bd5\u7528\u534f\u8bae\uff1a\u6570\u636e\u5f52\u5c5e\u4e0e\u4fdd\u5bc6\u6761\u6b3e</li> <li>[ ] \u6848\u4f8b\u6388\u6743\uff1a\u8bbf\u8c08\u4e0e\u5bf9\u5916\u5f15\u7528\u7684\u4e66\u9762\u8bb8\u53ef</li> </ul>"},{"location":"legal/hosted-service-checklist/#_3","title":"\u8d1f\u8d23\u4eba","text":"\u4e8b\u9879 \u8d1f\u8d23\u4eba \u72b6\u6001 \u4e3b\u4f53\u4e0e\u8d44\u8d28 \u9879\u76ee\u8d1f\u8d23\u4eba + \u5916\u90e8\u5f8b\u5e08 \u2b1c \u672a\u5f00\u59cb \u7528\u6237\u6587\u6863 \u9879\u76ee\u8d1f\u8d23\u4eba + \u5916\u90e8\u5f8b\u5e08 \u2b1c \u672a\u5f00\u59cb \u8bd5\u70b9\u534f\u8bae \u9879\u76ee\u8d1f\u8d23\u4eba \u2b1c \u672a\u5f00\u59cb"}]}