f4\u656c\u65e9\u671f\u8ba1\u7b97\u673a\u6587\u5316\uff1b\u5546\u6807\u68c0\u7d22\u4e0e\u6539\u540d\u8fdb\u884c\u4e2d\uff0c\u89c1 \u547d\u540d\u65b9\u6848\u3002</p>"},{"location":"faq/#_1","title":"\u793e\u533a\u7248\u4f1a\u6536\u8d39\u6216\u95ed\u6e90\u5417\uff1f","text":"<p>\u4e0d\u4f1a\u3002\u793e\u533a\u5baa\u7ae0 \u627f\u8bfa\uff1a\u793e\u533a\u7248\u6c38\u4e0d\u95ed\u6e90\uff08MIT\uff09\uff0c\u529f\u80fd\u53ea\u589e\u4e0d\u51cf\u3002\u6536\u8d39\u53ea\u53d1\u751f\u5728\u6258\u7ba1\u670d\u52a1\u4e0e\u4f01\u4e1a\u7248\u65b0\u589e\u529f\u80fd\u4e0a\u3002</p>"},{"location":"faq/#_2","title":"\u6211\u80fd\u7528\u5b83\u505a\u4ec0\u4e48\uff1f","text":"<p>\u89c4\u5212\u4e2d\u7684\u80fd\u529b\u89c1 \u9996\u9875\u3002\u9879\u76ee\u5904\u4e8e pre-alpha\uff0c\u53ef\u8fd0\u884c\u7248\u672c\u5c1a\u672a\u53d1\u5e03\uff0c\u8bf7\u5173\u6ce8 \u8def\u7ebf\u56fe\u3002</p>"},{"location":"faq/#_3","title":"\u5982\u4f55\u8d5e\u52a9\u9879\u76ee\uff1f","text":"<p>\u4ed3\u5e93\u9876\u90e8\u7684 Sponsor \u6309\u94ae\uff0c\u4e09\u6863 \u00a515 / \u00a550 / \u00a5500\u3002\u8d44\u91d1\u6bcf\u5b63\u5ea6\u516c\u5f00\u62a5\u544a\u3002</p>"},{"location":"faq/#_4","title":"\u9047\u5230\u95ee\u9898\u600e\u4e48\u529e\uff1f","text":"<p>\u5148\u641c Issue\uff1bBug \u7528 Bug \u6a21\u677f\uff1b\u5b89\u5168\u95ee\u9898\u8bf7\u6309 \u5b89\u5168\u7b56\u7565 \u79c1\u4e0b\u4e0a\u62a5\u3002</p>"},{"location":"installation/","title":"\u5b89\u88c5","text":""},{"location":"installation/#_2","title":"\u65b9\u5f0f\u4e00\uff1a\u76f4\u63a5\u8fd0\u884c\uff08\u63a8\u8350\uff0c\u96f6\u4f9d\u8d56\uff09","text":"<pre><code>git clone https://github.com/WL-2598/Compaq.git\ncd Compaq\npython3 -m compaq demo\n</code></pre> <ul> <li>\u9700\u8981 Python 3.9+\uff0c\u65e0\u9700 pip \u5b89\u88c5\u4efb\u4f55\u4e1c\u897f</li> <li>\u9002\u5408\u65e7\u673a\u5668\u3001\u53d7\u9650\u73af\u5883\u3001\u53ea\u60f3\u5feb\u901f\u4f53\u9a8c</li> </ul>"},{"location":"installation/#_3","title":"\u65b9\u5f0f\u4e8c\uff1a\u5b89\u88c5\u4e3a\u547d\u4ee4\u884c\u5de5\u5177","text":"<pre><code>cd Compaq\npip install .        # \u6216 pipx install .\uff08\u9694\u79bb\u73af\u5883\uff0c\u63a8\u8350\uff09\ncompaq version\n</code></pre> <p>\u5378\u8f7d\uff1a<code>pip uninstall compaq</code>\u3002</p>"},{"location":"installation/#docker","title":"\u65b9\u5f0f\u4e09\uff1aDocker\uff08\u6258\u7ba1/\u670d\u52a1\u5668\uff09","text":"<pre><code>cd deploy\ndocker compose up -d\n# \u4eea\u8868\u76d8 \u2192 http://localhost:8642\n</code></pre> <p>\u955c\u50cf\u57fa\u4e8e <code>python:3.12-slim</code>\uff0c\u975e root \u8fd0\u884c\uff0c\u5185\u7f6e\u5065\u5eb7\u68c0\u67e5\u4e0e\u6bcf\u65e5\u5907\u4efd\u670d\u52a1\u3002\u8be6\u89c1 deploy/README.md\u3002</p>"},{"location":"installation/#_4","title":"\u7cfb\u7edf\u8981\u6c42","text":"\u9879 \u6700\u4f4e \u8bf4\u660e Python 3.9 \u4ec5\u6807\u51c6\u5e93 \u5185\u5b58 ~30MB \u5b9e\u4f8b + \u865a\u62df\u673a 4KB \u5185\u5b58 \u78c1\u76d8 &lt;5MB \u4ee3\u7801 + \u5b9e\u4f8b\u6570\u636e \u7f51\u7edc \u4e0d\u9700\u8981 \u9664\u514b\u9686\u4ed3\u5e93\u5916\u5b8c\u5168\u79bb\u7ebf"},{"location":"installation/#_5","title":"\u9a8c\u8bc1\u5b89\u88c5","text":"<pre><code>python3 -m compaq doctor\n</code></pre> <p>\u8f93\u51fa\u56db\u9879 \u2714 \u5373\u73af\u5883\u5c31\u7eea\u3002</p>"},{"location":"metrics/","title":"\u6307\u6807\u770b\u677f","text":"<p>\u6bcf\u5468\u8bb0\u5f55\u4e00\u6b21\uff08\u5468\u65e5\uff09\uff0c\u57fa\u7ebf\u5728\u7b2c 2 \u5468\u5efa\u7acb\u3002\u6570\u636e\u6765\u6e90\u89c1\u5404\u5217\u3002</p>"},{"location":"metrics/#6","title":"\u76ee\u6807\uff08\u7b2c 6 \u5468\uff09","text":"\u6307\u6807 \u7b2c 2 \u5468\u57fa\u7ebf \u7b2c 6 \u5468\u76ee\u6807 \u6765\u6e90 \u6700\u65b0\u503c Stars \u5f85\u8bb0\u5f55 \u8f83\u7b2c 2 \u5468 +15% GitHub Insights Issue \u9996\u6b21\u54cd\u5e94\u65f6\u95f4\uff08\u4e2d\u4f4d\u6570\uff09 \u5f85\u8bb0\u5f55 \u2264 72 \u5c0f\u65f6 GitHub \u7edf\u8ba1 \u5916\u90e8 PR \u5408\u5e76\u6570 \u5f85\u8bb0\u5f55 \u2265 5 GitHub \u6587\u6863\u7ad9\u5468\u8bbf\u95ee\u91cf \u5f85\u8bb0\u5f55 \u2265 1000 GA \u6216 Plausible \u8d5e\u52a9\u4eba\u6570 \u5f85\u8bb0\u5f55 \u2265 20 Sponsors \u540e\u53f0"},{"location":"metrics/#_2","title":"\u5468\u8bb0\u5f55","text":"\u5468\u6b21 \u65e5\u671f Stars Issue \u4e2d\u4f4d\u9996\u54cd \u5916\u90e8 PR \u6587\u6863\u5468\u8bbf\u95ee \u8d5e\u52a9\u4eba \u5907\u6ce8 1 2026-11-24 \u5730\u57fa\u5468\uff1a\u6cbb\u7406 + v0.1.0 \u4ea7\u54c1\uff0839 \u6d4b\u8bd5\u901a\u8fc7\uff09"},{"location":"naming/","title":"\u5546\u6807\u4e0e\u547d\u540d\u65b9\u6848\uff08P0 \u6700\u4f18\u5148\uff09","text":"<p>\u72b6\u6001\uff1a\ud83d\udfe1 \u5f85\u4eba\u5de5\u68c0\u7d22\u3002\u672a\u89e3\u51b3\u524d\u4e0d\u505a\u4efb\u4f55\u5546\u4e1a\u52a8\u4f5c\uff08\u6536\u6b3e\u3001\u5b9a\u4ef7\u3001\u7b7e\u5408\u540c\uff09\u3002 \u672c\u73af\u5883\u7f51\u7edc\u53d7\u9650\uff0c\u65e0\u6cd5\u8bbf\u95ee\u5546\u6807\u5c40\u6570\u636e\u5e93\uff0c\u68c0\u7d22\u987b\u7531\u9879\u76ee\u8d1f\u8d23\u4eba\u5b8c\u6210\u3002</p>"},{"location":"naming/#_1","title":"\u4e3a\u4ec0\u4e48","text":"<p>\"Compaq\" \u662f\u60e0\u666e\uff08HP\uff09\u6301\u6709\u7684\u77e5\u540d\u5546\u6807\uff08Compaq 1982 \u5e74\u521b\u7acb\uff0c2002 \u5e74\u88ab HP \u6536\u8d2d\uff09\u3002\u7ee7\u7eed\u4ee5 Compaq \u540d\u4e49\u505a\u5546\u4e1a\u5316\u5b58\u5728\u5546\u6807\u98ce\u9669\u3002\u5efa\u8bae\uff1a\u4fdd\u7559\"\u5eb7\u67cf\"\u4f5c\u4e3a\u793e\u533a\u6635\u79f0\uff0c\u6b63\u5f0f\u540d\u79f0\u6362\u6210\u4e0e\u539f\u5546\u6807\u65e0\u5173\u7684\u540d\u5b57\u3002</p>"},{"location":"naming/#_2","title":"\u5019\u9009\u540d\uff08\u4e09\u4e2a\uff09","text":"\u5019\u9009 \u542b\u4e49 \u9700\u68c0\u67e5 RetroBox \u590d\u53e4 + \u76d2\u5b50/\u73af\u5883\uff0c\u76f4\u767d\u597d\u8bb0 \u5546\u6807 / \u57df\u540d / GitHub \u7ec4\u7ec7\u540d KangHub \"\u5eb7\"\u97f3\u8bd1 + \u4e2d\u5fc3\uff0c\u4fdd\u7559\u793e\u533a\u6635\u79f0\u7684\u6839 \u540c\u4e0a RetroNest \u590d\u53e4 + \u5de2/\u6816\u606f\u5730\uff0c\u504f\u793e\u533a\u611f \u540c\u4e0a"},{"location":"naming/#_3","title":"\u4e09\u9879\u68c0\u7d22\uff08\u4eba\u5de5\u5b8c\u6210\uff09","text":"<ol> <li>\u5546\u6807</li> <li>\u4e2d\u56fd\uff1a\u56fd\u5bb6\u77e5\u8bc6\u4ea7\u6743\u5c40\u5546\u6807\u67e5\u8be2 https://sbj.cnipa.gov.cn/</li> <li>\u7f8e\u56fd\uff1aUSPTO TESS https://tmsearch.uspto.gov/</li> <li>\u5173\u952e\u8bcd\uff1a\u5019\u9009\u540d + \u7b2c 9 / 42 \u7c7b\uff08\u8f6f\u4ef6\u3001SaaS\uff09\uff0c\u540c\u65f6\u68c0\u7d22\"\u5eb7\u67cf\"\u5728\u76f8\u5173\u7c7b\u522b\u7684\u5728\u5148\u6ce8\u518c</li> <li>\u57df\u540d\uff1a\u5019\u9009\u540d + <code>.com</code> / <code>.dev</code> / <code>.io</code> \u662f\u5426\u53ef\u6ce8\u518c</li> <li>GitHub\uff1a\u7ec4\u7ec7\u540d\u6216\u7528\u6237\u540d\u662f\u5426\u53ef\u7528</li> </ol>"},{"location":"naming/#_4","title":"\u6539\u540d\u540e\u5fc5\u987b\u505a\u7684\u4e09\u4ef6\u4e8b","text":"<ol> <li>README \u9876\u90e8\u52a0\u5165\u58f0\u660e\uff08\u8349\u6848\uff09\uff1a</li> </ol> <p>\u672c\u9879\u76ee\u4e0e Compaq \u6216 HP \u65e0\u5173\u8054\uff0c\u540d\u79f0\u4ec5\u4e3a\u81f4\u656c\u65e9\u671f\u8ba1\u7b97\u673a\u6587\u5316\u3002</p> <ol> <li>\u4ed3\u5e93\u6539\u540d\uff08GitHub \u2192 Settings \u2192 Repository name\uff09\uff0cGitHub \u4f1a\u81ea\u52a8\u91cd\u5b9a\u5411\u65e7\u5730\u5740\uff1b</li> <li>\u540c\u6b65\u66f4\u65b0 README\u3001docs\u3001<code>.github/FUNDING.yml</code>\u3001\u6587\u6863\u7ad9\u3001\u793e\u4ea4\u6e20\u9053\u4e0e\u5df2\u53d1\u5e03\u5185\u5bb9\u3002</li> </ol>"},{"location":"naming/#_5","title":"\u51b3\u7b56\u8bb0\u5f55","text":"\u65e5\u671f \u51b3\u5b9a \u51b3\u7b56\u4eba \u5f85\u5b9a \u6700\u7ec8\u540d\u79f0 \u9879\u76ee\u8d1f\u8d23\u4eba"},{"location":"quickstart/","title":"\u5feb\u901f\u5f00\u59cb","text":"<p>\u9a8c\u6536\u6807\u51c6\uff1a\u4e00\u4e2a\u4ece\u672a\u63a5\u89e6\u9879\u76ee\u7684\u4eba\uff0c\u53ea\u770b\u672c\u9875\u5373\u53ef\u5728 5 \u5206\u949f\u5185\u8dd1\u901a\u2014\u2014\u8fd9\u662f\u552f\u4e00\u6709\u6548\u7684\u6d4b\u8bd5\u3002</p>"},{"location":"quickstart/#_2","title":"\u524d\u7f6e\u6761\u4ef6","text":"<ul> <li>Python 3.9+\uff08<code>python3 --version</code> \u67e5\u770b\uff09</li> <li>\u65e0\u9700 Docker\u3001\u65e0\u9700\u4efb\u4f55\u7b2c\u4e09\u65b9\u5305\uff08\u96f6\u4f9d\u8d56\u8bbe\u8ba1\uff0c\u8001\u673a\u5668\u53cb\u597d\uff09</li> </ul>"},{"location":"quickstart/#5","title":"5 \u5206\u949f\u8def\u5f84","text":"<pre><code># 1. \u83b7\u53d6\u4ee3\u7801\ngit clone https://github.com/WL-2598/Compaq.git\ncd Compaq\n\n# 2. \u8dd1\u901a\uff1a\u5f00\u673a\u52a8\u753b\uff08COMPAQ \u5b57\u6837\u95ea\u70c1\uff09\npython -m compaq demo\n</code></pre> <p>\u770b\u5230\u7ec8\u7aef\u91cc\u7684\u7eff\u8272\u50cf\u7d20\u753b\u9762\u548c\"\u2714 \u8dd1\u901a\u4e86\"\u5373\u6210\u529f\u3002\u6570\u636e\u5199\u5165 <code>./.compaq/</code>\uff08\u5df2 gitignore\uff09\u3002</p>"},{"location":"quickstart/#_3","title":"\u7b2c\u4e8c\u6b65\uff1a\u52a8\u753b\u9884\u89c8\u4e0e\u4eea\u8868\u76d8","text":"<pre><code>python -m compaq run demo --watch --frames 300    # \u7ec8\u7aef\u5b9e\u65f6\u52a8\u753b\uff08\u5c0f\u7403\uff09\npython -m compaq dashboard                        # \u6d4f\u89c8\u5668\u6253\u5f00 http://127.0.0.1:8642\n</code></pre> <p>\u4eea\u8868\u76d8\u4f1a\u663e\u793a\u5b9e\u4f8b\u5217\u8868\u548c\u5b9e\u65f6\u753b\u9762\uff1b<code>/healthz</code> \u8fd4\u56de <code>{\"status\":\"ok\"}</code>\u3002</p>"},{"location":"quickstart/#_4","title":"\u7b2c\u4e09\u6b65\uff1a\u521b\u5efa\u4f60\u81ea\u5df1\u7684\u5b9e\u4f8b","text":"<pre><code>python -m compaq create mygame --rom bounce       # \u6216 --rom &lt;\u4f60\u81ea\u5df1\u7684ROM\u6587\u4ef6\u540d&gt;\npython -m compaq list\npython -m compaq run mygame --watch\npython -m compaq backup mygame                    # \u5907\u4efd\npython -m compaq restore mygame                   # \u6062\u590d\u6700\u65b0\u5907\u4efd\n</code></pre> <p>\u81ea\u5df1\u7684 ROM \u653e\u5230 <code>.compaq/instances/mygame/roms/</code> \u4e0b\uff0c\u7136\u540e <code>--rom &lt;\u6587\u4ef6\u540d&gt;</code>\u3002</p>"},{"location":"quickstart/#_5","title":"\u53ef\u9009\uff1a\u5b89\u88c5\u4e3a\u547d\u4ee4\u884c\u5de5\u5177","text":"<pre><code>pip install .          # \u5b89\u88c5\u540e\u53ef\u76f4\u63a5\u7528 `compaq` \u547d\u4ee4\n# \u6216: pipx install .\ncompaq version\n</code></pre>"},{"location":"quickstart/#_6","title":"\u9047\u5230\u95ee\u9898\uff1f","text":"<pre><code>python -m compaq doctor    # \u73af\u5883\u81ea\u68c0\uff08Python\u3001\u76ee\u5f55\u3001\u865a\u62df\u673a\u3001\u6ce8\u518c\u8868\uff09\n</code></pre> <p>\u4ecd\u5931\u8d25 \u2192 \u7528 Bug \u6a21\u677f \u5f00 Issue\uff0c\u9644\u4e0a <code>doctor</code> \u8f93\u51fa\u3002</p>"},{"location":"quickstart/#_7","title":"\u4e0b\u4e00\u6b65","text":"<ul> <li>\u4e86\u89e3\u8bbe\u8ba1 \u2192 \u67b6\u6784\u8bf4\u660e</li> <li>\u5199\u63d2\u4ef6 \u2192 registry/ \u89c4\u8303</li> <li>\u53c2\u4e0e\u8d21\u732e \u2192 \u8d21\u732e\u6307\u5357</li> </ul>"},{"location":"roadmap/","title":"\u516c\u5f00\u8def\u7ebf\u56fe","text":"<p>\u66f4\u65b0\u4e8e 2026-11-24\u3002\u6bcf\u5468\u5bf9\u7167 \u6307\u6807\u770b\u677f\u3002\u9636\u6bb5\u5212\u5206\u6765\u81ea\u76c8\u5229\u5b9e\u65bd\u8ba1\u5212\uff0c\u65e5\u671f\u6309\u7b2c 1 \u5468 = 2026-11-23 \u8d77\u7b97\u3002</p>"},{"location":"roadmap/#2026-q4-16-p0-p1","title":"2026 Q4\uff08\u7b2c 1\u20136 \u5468\uff1aP0 \u5730\u57fa \u2192 P1 \u793e\u533a\uff09","text":"\u9636\u6bb5 \u8ba1\u5212 \u72b6\u6001 P0 \u5730\u57fa \u5546\u6807\u68c0\u7d22\u4e0e\u6539\u540d\u65b9\u6848\u3001\u8bb8\u53ef\u8bc1\u5ba1\u8ba1\u3001\u6cbb\u7406\u6587\u4ef6\u3001\u8d5e\u52a9\u901a\u9053\u3001Issue/PR \u6a21\u677f\u4e0e CI \u2705 \u5df2\u5b8c\u6210\uff08\u5546\u6807\u7ec8\u9009\u4e0e Sponsors \u540e\u53f0\u5f85\u4eba\u5de5\uff09 P1 \u793e\u533a README \u91cd\u5199\u3001\u53d1\u5e03\u8282\u594f\u3001\u6587\u6863\u7ad9\u3001\u5185\u5bb9\u65e5\u5386\u3001\u6307\u6807\u770b\u677f \u2705 \u9aa8\u67b6\u5b8c\u6210\uff08\u5185\u5bb9\u53d1\u5e03\u8fdb\u884c\u4e2d\uff09 P0.5 \u4